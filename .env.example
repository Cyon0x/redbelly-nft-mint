# ---------------------------------------------------------------------------
# Frontend (safe to expose — NEXT_PUBLIC_* values ship to the browser)
# ---------------------------------------------------------------------------

# The deployed collection contract. Leave empty until deployment; the site
# renders a coherent pre-launch state without it.
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=

# 151 = Redbelly Mainnet (default). 153 = Redbelly Testnet.
NEXT_PUBLIC_CHAIN_ID=151

# Canonical site URL, used for metadata and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Contract deployment (contracts/.env — NEVER commit real values)
# ---------------------------------------------------------------------------
#
# NO PRIVATE KEY GOES IN THIS FILE.
#
# Import your deployer key once into Foundry's encrypted keystore instead:
#
#     cast wallet import redbelly-deployer --interactive
#
# It is encrypted with a password you choose and stored outside the repo in
# ~/.foundry/keystores. Deploy with `--account redbelly-deployer`; Foundry
# prompts for the password at deploy time. The key never touches this repo,
# your shell history, or any chat window.

REDBELLY_MAINNET_RPC_URL=https://governors.mainnet.redbelly.network
REDBELLY_TESTNET_RPC_URL=https://governors.testnet.redbelly.network

# Routescan's Etherscan-compatible verification API.
# "verifyContract" is Routescan's documented public key for this endpoint.
EXPLORER_API_URL=https://api.routescan.io/v2/network/mainnet/evm/151/etherscan
EXPLORER_TESTNET_API_URL=https://api.routescan.io/v2/network/testnet/evm/153/etherscan
EXPLORER_API_KEY=verifyContract

# --- Collection configuration (all optional; defaults live in Deploy.s.sol) ---
COLLECTION_NAME=Redbelly Genesis
COLLECTION_SYMBOL=RBGEN
MAX_SUPPLY=500
MINT_PRICE_WEI=0
MAX_PER_WALLET=5
ROYALTY_BPS=500

# Defaults to the deployer address when unset.
OWNER_ADDRESS=
ROYALTY_RECEIVER=

# Metadata shown for every token until reveal.
UNREVEALED_URI=ipfs://placeholder/prereveal.json
